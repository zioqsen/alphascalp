# ============================================================
#  .gitignore — AlphaScalp
#  On versionne le CODE ; jamais les secrets, la base, ni les
#  données utilisateurs (clés d'abonnés, emails...).
# ============================================================

# --- Secrets & jetons ---
*.env
.env
.env.*
token.txt
*_token.txt
*secret*

# --- Base de données (contient les clés/abonnés = données perso) ---
*.db
*.sqlite
*.sqlite3

# --- Données utilisateurs / rapports générés ---
users/
ReportHistory.xlsx
# NB : performance.html est généré par alphascalp_showcase.py mais on le
# VERSIONNE quand même — c'est une page publique (données de démo, aucun
# secret) qui doit partir sur l'hébergeur. Flo la régénère + push pour
# rafraîchir les chiffres (mise à jour manuelle = maîtrise de ce qu'on affiche).

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Divers ---
*.log
*.tmp
.DS_Store
Thumbs.db

# Dossier temporaire du client Google Drive. Ce projet est synchronisé, et
# le client y dépose des fragments pendant l'envoi. Rien à versionner.
.tmp.driveupload/
